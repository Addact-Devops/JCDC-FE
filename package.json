{
    "name": "jcdc-homepage",
    "version": "2.2.0",
    "description": "JCDC Homepage — pixel-perfect Figma implementation in vanilla HTML/SCSS/JS",
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').mkdirSync('dist',{recursive:true})\"",
        "build:css": "sass src/scss/main.scss dist/main.css --style=expanded --no-source-map",
        "build:css:min": "sass src/scss/main.scss dist/main.min.css --style=compressed --no-source-map",
        "build:js": "node build/bundle-js.js",
        "build:js:min": "terser dist/main.js -o dist/main.min.js --compress --mangle",
        "build": "npm run clean && npm run build:css && npm run build:css:min && npm run build:js && npm run build:js:min",
        "watch:css": "sass src/scss/main.scss dist/main.css --watch --style=expanded",
        "watch:css:min": "sass src/scss/main.scss dist/main.min.css --watch --style=compressed",
        "watch:js": "node build/watch-js.js",
        "serve": "npx --yes http-server . -p 3000 -c-1",
        "dev": "npm-run-all --parallel watch:css watch:css:min watch:js serve",
        "start": "npm run build && npm run dev"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5",
        "sass": "^1.77.0",
        "terser": "^5.31.0"
    }
}
